# Scrum — self-hosted rugby prediction league
# Copy this file to .env and fill in your values

# Admin credentials (created automatically on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Session signing secret — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change_this_to_a_random_hex_string

# Redis connection (leave as-is if using docker-compose)
REDIS_URL=redis://redis:6379

# Database path inside the container (leave as-is)
DB_PATH=/data/scrum.db

# Port to expose (default 8888)
PORT=8888
