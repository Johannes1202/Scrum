# Scrum — Rugby Prediction App
# Copy this file to .env and fill in your values

# Admin account (created automatically on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Session security — generate a random 64-char hex string
# Linux: openssl rand -hex 32
# Windows: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace_this_with_a_random_64_char_hex_string

# Redis connection (leave as-is if using docker-compose)
REDIS_URL=redis://redis:6379

# Database path (leave as-is if using docker-compose)
DB_PATH=/data/scrum.db

# Port to expose (default 8888)
PORT=8888
