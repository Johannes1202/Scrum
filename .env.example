# Scrum — Rugby Prediction App
# Copy this file to .env and fill in your values.
# Everything below the required block has a sensible default — uncomment only
# what you want to change.

# ── Required ──────────────────────────────────────────────────────────────────

# Admin account (created automatically on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Session security — generate a random 64-char hex string
# Linux: openssl rand -hex 32
# Windows: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace_this_with_a_random_64_char_hex_string

# ── Standard, fine as-is with docker-compose ──────────────────────────────────

REDIS_URL=redis://redis:6379
DB_PATH=/data/scrum.db
PORT=8888

# ── Optional ──────────────────────────────────────────────────────────────────

# Mark session cookies Secure. Only enable if you reach the app EXCLUSIVELY over
# HTTPS — with this on, plain-HTTP and LAN access can no longer log in.
#COOKIE_SECURE=1

# Results kicking off before this date are never stored. The companion backfill
# reaches 45 days into the past, so without a floor it will refill history you
# deliberately cleared. Set this to your season cutover date.
#RESULTS_FLOOR=2026-07-04

# Where uploaded profile pictures and cached team crests are written. Both sit
# inside the data volume by default so they survive a rebuild.
#AVATAR_DIR=/data/avatars
#CREST_DIR=/data/crests

# Discovery check — flags fixtures a secondary source knows about and ESPN does
# not. Advisory only: nothing it finds affects scoring until an admin adds it.
# "3" is TheSportsDB's free development key and is heavily rate-limited, hence
# the pacing. Requests stop cleanly on a 429 and resume next run.
#SPORTSDB_KEY=3
#SPORTSDB_DELAY=1.5
#DISCOVERY_INTERVAL=86400
